// Jenkinsfile-backend — FINAL, NO HIDDEN CREDENTIALS, WORKS 100%
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    environment {
        DOCKER_IMAGE = 'kartikartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Test') {
           steps {
               dir('backend') {
                   sh 'npm ci --legacy-peer-deps'
                   sh 'npm test -- --coverage --coverageReporters=lcov || true'
               }
           }
        }

        stage('SonarCloud') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    dir('backend') {
                        sh '''sonar-scanner \\
                          -Dsonar.projectKey=kartik-yo_user-handling-system-backend \\
                          -Dsonar.organization=kartik-yo \\
                          -Dsonar.host.url=https://sonarcloud.io \\
                          -Dsonar.login=${SONAR_TOKEN} \\
                          -Dsonar.sources=. \\
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info'''
                    }
                }
            }
        }

        // stage('SonarCloud Quality Gate') {
        //     steps {
        //         timeout(time: 5, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def img = "${DOCKER_IMAGE}:backend-${BUILD_NUMBER}"
                        def lat = "${DOCKER_IMAGE}:backend-latest"

                        withCredentials([usernamePassword(credentialsId: 'docker-creds',
                                                         usernameVariable: 'U', passwordVariable: 'P')]) {
                            sh """
                                sudo docker logout || true
                                echo "\$P" | sudo docker login -u "\$U" --password-stdin
                                sudo docker build -t ${img} -t ${lat} .
                                sudo docker push ${img}
                                sudo docker push ${lat}
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "SUCCESS → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "FAILED – you probably still have hidden Docker credentials in job config" }
    }
}
