// Jenkinsfile (single file for both — or split into two)
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'    // name from Jenkins → Global Tool Configuration
    }

    environment {
        DOCKER_IMAGE = 'kartikmesh2406/user-handling-app'
        DOCKER_CREDS = credentials('docker-creds')
        SONAR_TOKEN  = credentials('sonarqube-token')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Install & Test') {
            when { changeset "backend/**" }
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || echo "No tests"'
                }
            }
        }

        stage('Frontend: Install & Build & Test') {
            when { changeset "frontend/**" }
            steps {
                dir('frontend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm run build'
                    sh 'npm run test:cov -- --coverage --coverageReporters=lcov'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('MySonarQube') {   // configured in Jenkins Global Config
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=user-handling-system \
                          -Dsonar.sources=. \
                          -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info,frontend/coverage/lcov.info
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            parallel {
                stage('Backend Image') {
                    when { changeset "backend/**" }
                    steps {
                        dir('backend') {
                            script {
                                def tag = "backend-${BUILD_NUMBER}"
                                sh "docker build -t ${DOCKER_IMAGE}:${tag} ."
                                docker.withRegistry('', 'docker-creds') {
                                    sh "docker push ${DOCKER_IMAGE}:${tag}"
                                    sh "docker tag ${DOCKER_IMAGE}:${tag} ${DOCKER_IMAGE}:backend-latest"
                                    sh "docker push ${DOCKER_IMAGE}:backend-latest"
                                }
                            }
                        }
                    }
                }
                stage('Frontend Image') {
                    when { changeset "frontend/**" }
                    steps {
                        dir('frontend') {
                            script {
                                def tag = "frontend-${BUILD_NUMBER}"
                                sh "docker build -t ${DOCKER_IMAGE}:${tag} ."
                                docker.withRegistry('', 'docker-creds') {
                                    sh "docker push ${DOCKER_IMAGE}:${tag}"
                                    sh "docker tag ${DOCKER_IMAGE}:${tag} ${DOCKER_IMAGE}:frontend-latest"
                                    sh "docker push ${DOCKER_IMAGE}:frontend-latest"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always  { cleanWs() }
        success { echo 'Pipeline succeeded — images pushed!' }
        failure { echo 'Pipeline failed' }
    }
}