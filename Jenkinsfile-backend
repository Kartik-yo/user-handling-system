// Jenkinsfile-backend — FIXED FOR SONAR PLUGINS
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'  // Now works
    }

    environment {
        DOCKER_IMAGE = 'kartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Install & Test') {
            steps {
                dir('backend') {
                    nodejs(nodeJSInstallationName: 'NodeJS-22') {
                        sh 'npm ci --legacy-peer-deps'
                        sh 'npm test -- --coverage --coverageReporters=lcov || echo "No backend tests found"'
                    }
                }
            }
        }

        stage('SonarQube Analysis - Backend') {
            steps {
                withSonarQubeEnv('MySonarQubeServer') {  // Now works after plugin
                    dir('backend') {
                        nodejs(nodeJSInstallationName: 'NodeJS-22') {
                            sh '''
                                sonar-scanner \
                                  -Dsonar.projectKey=user-handling-system-backend \
                                  -Dsonar.sources=. \
                                  -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                            '''
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true  // Now works after plugin
                }
            }
        }

        stage('Docker Build & Push - Backend') {
            steps {
                dir('backend') {
                    script {
                        def tag = "backend-${BUILD_NUMBER}"
                        def image = docker.build("${DOCKER_IMAGE}:${tag}")

                        docker.withRegistry('https://registry.hub.docker.com', 'docker-creds') {
                            image.push(tag)
                            image.push('backend-latest')
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "BACKEND SUCCESS → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "BACKEND FAILED" }
    }
}