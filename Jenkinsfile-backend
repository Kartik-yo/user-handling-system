// Jenkinsfile-backend
pipeline {
    agent any

    environment {
        DOCKER_CREDS = credentials('docker-creds')
        GIT_CREDS    = credentials('github-cred')
        SONAR_TOKEN  = credentials('sonarqube-token')   // secret text
    }

    stages {
        stage('Backend → Test → SonarQube → Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS'),
                    usernamePassword(credentialsId: 'github-cred', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS'),
                    string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN'),
                    sshUserPrivateKey(credentialsId: 'ssh_user_and_key', keyFileVariable: 'SSH_KEY_FILE', usernameVariable: 'SSH_USER')
                ]) {
                    sh '''
                        set -euo pipefail

                        # THIS IS THE ONLY CORRECT WAY
                        ssh -o StrictHostKeyChecking=no -i "$SSH_KEY_FILE" ubuntu@3.236.244.98 << 'EOF'
                        echo "Successfully connected to EC2"

                        cd ~
                        rm -rf user-handling-system
                        git clone https://$GIT_USER:$GIT_PASS@github.com/Kartik-yo/user-handling-system.git
                        cd user-handling-system/backend

                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                        npm ci --legacy-peer-deps
                        npm test -- --coverage --coverageReporters=lcov || echo "No tests found"

                        sonar-scanner \
                          -Dsonar.projectKey=user-handling-system-backend \
                          -Dsonar.sources=. \
                          -Dsonar.host.url=http://localhost:9000 \
                          -Dsonar.login=$SONAR_TOKEN \
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info

                        TAG=backend-${BUILD_NUMBER:-latest}
                        docker build -t kartikmesh2406/user-handling-app:$TAG .
                        docker push kartikmesh2406/user-handling-app:$TAG
                        docker tag kartikmesh2406/user-handling-app:$TAG kartikmesh2406/user-handling-app:backend-latest
                        docker push kartikmesh2406/user-handling-app:backend-latest

                        echo "BACKEND SUCCESS"
                        EOF
                    '''
                }
            }
        }
    }

    post {
        success { echo 'Backend pipeline succeeded!' }
        failure { echo 'Backend pipeline failed' }
    }
}