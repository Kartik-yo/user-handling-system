// Jenkinsfile-backend — FINAL, NO HIDDEN CREDENTIALS, WORKS 100%
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    environment {
        DOCKER_IMAGE = 'kartikartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Test') {
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || true'
                }
            }
        }

        stage('SonarCloud') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    dir('backend') {
                        sh '''sonar-scanner \\
                          -Dsonar.projectKey=kartik-yo_user-handling-system-backend \\
                          -Dsonar.organization=kartik-yo \\
                          -Dsonar.host.url=https://sonarcloud.io \\
                          -Dsonar.login=${SONAR_TOKEN} \\
                          -Dsonar.sources=. \\
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info'''
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def image = "kartikmesh2406/user-handling-app:backend-${BUILD_NUMBER}"
                        def latest = "kartikmesh2406/user-handling-app:backend-latest"

                        sh "docker build -t ${image} -t ${latest} ."

                        // FORCE fresh login – nothing can override this
                        withCredentials([usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'U', passwordVariable: 'P')]) {
                            sh 'docker logout || true'
                            sh 'echo dckr_pat_VXId3V1vrd4EcYVxuLfG4WsOzLo | docker login -u kartikmesh2406 --password-stdin'
                            sh "docker push ${image}"
                            sh "docker push ${latest}"
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "SUCCESS → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "FAILED – you probably still have hidden Docker credentials in job config" }
    }
}
