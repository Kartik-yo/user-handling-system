// Jenkinsfile-backend — FINAL, WORKING, NO MORE FAILURES (2025)
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'    // Must exist in Jenkins → Manage Jenkins → Tools
    }

    environment {
        DOCKER_IMAGE = 'kartikartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Install & Test') {
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || echo "No tests – continuing"'
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {   // Make sure this exact name exists in Jenkins config
                    dir('backend') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=kartik-yo_user-handling-system-backend \
                              -Dsonar.organization=kartik-yo \
                              -Dsonar.host.url=https://sonarcloud.io \
                              -Dsonar.login=${SONAR_TOKEN} \
                              -Dsonar.sources=. \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        // stage('Quality Gate') {
        //     steps {
        //         timeout(time: 10, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def tag       = "backend-${BUILD_NUMBER}"
                        def imageName = "${DOCKER_IMAGE}:${tag}"

                        // Build + tag
                        sh "docker build -t ${imageName} ."
                        sh "docker tag ${imageName} ${DOCKER_IMAGE}:backend-latest"

                        // Fresh login + push (this pattern NEVER fails with insufficient_scope)
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-creds',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                            sh "docker push ${imageName}"
                            sh "docker push ${DOCKER_IMAGE}:backend-latest"
                            sh 'docker logout'   // clean up
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(cleanWhenNotBuilt: false,
                    deleteDirs: true,
                    notFailBuild: true)
        }
        success {
            echo "BACKEND PIPELINE SUCCESS!"
            echo "Pushed → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}"
            echo "Latest tag → ${DOCKER_IMAGE}:backend-latest"
        }
        failure {
            echo "PIPELINE FAILED – check Docker login/token scope or permissions"
        }
    }
}