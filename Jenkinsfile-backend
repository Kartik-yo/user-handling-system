// Jenkinsfile-backend   ← ONLY FOR BACKEND
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'   // ← Make sure NodeJS Plugin is installed and this name exists
    }

    environment {
        DOCKER_IMAGE = 'kartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Install & Test') {
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || echo "No backend tests found"'
                }
            }
        }

        stage('SonarQube Analysis - Backend') {
            steps {
                withSonarQubeEnv('MySonarQubeServer') {   // ← Configure this in Jenkins Global Config
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=user-handling-system-backend \
                          -Dsonar.sources=backend \
                          -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push - Backend') {
            steps {
                dir('backend') {
                    script {
                        def tag = "backend-${BUILD_NUMBER}"
                        def image = docker.build("${DOCKER_IMAGE}:${tag}")

                        docker.withRegistry('https://registry.hub.docker.com', 'docker-creds') {
                            image.push()
                            image.push('backend-latest')
                        }
                    }
                }
            }
        }
    }

    post {
        always  { cleanWs() }
        success { echo "BACKEND PIPELINE SUCCESS → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "BACKEND PIPELINE FAILED" }
    }
}