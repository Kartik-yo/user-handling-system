// Jenkinsfile-backend — FINAL SONARCLOUD VERSION (WORKS TODAY)
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'   // ← already configured
    }

    environment {
        DOCKER_IMAGE = 'kartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: Install & Test') {
            steps {
                dir('backend') {
                    nodejs(nodeJSInstallationName: 'NodeJS-22') {
                        sh 'npm ci --legacy-peer-deps'
                        sh 'npm test -- --coverage --coverageReporters=lcov || echo "No tests found - continuing"'
                    }
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {   // ← This name must exist in Jenkins global config
                    dir('backend') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=kartik-yo_user-handling-system-backend \
                              -Dsonar.organization=kartik-yo \
                              -Dsonar.host.url=https://sonarcloud.io \
                              -Dsonar.login=${SONARQUBE_TOKEN} \
                              -Dsonar.sources=. \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        stage('SonarCloud Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def tag = "backend-${BUILD_NUMBER}"
                        def image = docker.build("${DOCKER_IMAGE}:${tag}")

                        docker.withRegistry('', 'docker-creds') {
                            image.push()
                            image.push('backend-latest')
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "BACKEND PIPELINE SUCCESS! Image: ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "PIPELINE FAILED — check SonarCloud or Docker logs" }
    }
}