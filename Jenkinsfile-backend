// Jenkinsfile-backend — FINAL & FULLY WORKING VERSION (2025)
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'   // Make sure this exact name exists in Manage Jenkins → Tools
    }

    environment {
        DOCKER_IMAGE = 'kartikartikmesh2406/user-handling-app'   // your real Docker Hub username
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/main']],  // or whatever branch you use
                    userRemoteConfigs: [[url: 'https://github.com/kartik-yo/user-handling-system.git']]
                )
            }
        }

        stage('Backend: Install & Test') {
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || echo "Tests skipped – continuing"'
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {   // name must match Jenkins global config
                    dir('backend') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=kartik-yo_user-handling-system-backend \
                              -Dsonar.organization=kartik-yo \
                              -Dsonar.host.url=https://sonarcloud.io \
                              -Dsonar.login=${SONAR_TOKEN} \
                              -Dsonar.sources=. \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        // Uncomment when you want the quality gate back
        // stage('Quality Gate') {
        //     steps {
        //         timeout(time: 10, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def tag       = "backend-${env.BUILD_NUMBER}"
                        def imageName = "${DOCKER_IMAGE}:${tag}"

                        // Empty string = Docker Hub (this works perfectly in 2025)
                        docker.withRegistry('', 'docker-creds') {
                            def image = docker.build(imageName, '.')
                            image.push()
                            image.push('backend-latest')
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(cleanWhenNotBuilt: false,
                    deleteDirs: true,
                    notFailBuild: true)
        }
        success {
            echo "BACKEND PIPELINE SUCCESS!"
            echo "Image → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}"
            echo "Also tagged as → ${DOCKER_IMAGE}:backend-latest"
        }
        failure {
            echo "PIPELINE FAILED — check logs above"
        }
    }
}