// Jenkinsfile-backend — FINAL, NO HIDDEN CREDENTIALS, WORKS 100%
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    environment {
        DOCKER_IMAGE = 'kartikartikmesh2406/user-handling-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Test') {
            steps {
                dir('backend') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --coverage --coverageReporters=lcov || true'
                }
            }
        }

        stage('SonarCloud') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    dir('backend') {
                        sh '''sonar-scanner \\
                          -Dsonar.projectKey=kartik-yo_user-handling-system-backend \\
                          -Dsonar.organization=kartik-yo \\
                          -Dsonar.host.url=https://sonarcloud.io \\
                          -Dsonar.login=${SONAR_TOKEN} \\
                          -Dsonar.sources=. \\
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info'''
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('backend') {
                    script {
                        def tag = "backend-${BUILD_NUMBER}"
                        def image = "${DOCKER_IMAGE}:${tag}"

                        sh "docker build -t ${image} ."
                        sh "docker tag ${image} ${DOCKER_IMAGE}:backend-latest"

                        // THIS IS THE ONLY LOGIN THAT WILL BE USED
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-creds',
                            usernameVariable: 'USER',
                            passwordVariable: 'PASS')]) {

                            sh 'echo "$PASS" | docker login -u "$USER" --password-stdin'
                            sh "docker push ${image}"
                            sh "docker push ${DOCKER_IMAGE}:backend-latest"
                            sh 'docker logout'
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "SUCCESS → ${DOCKER_IMAGE}:backend-${BUILD_NUMBER}" }
        failure { echo "FAILED – you probably still have hidden Docker credentials in job config" }
    }
}